# Copy this file to .env and fill in your key. Never commit .env.

# Which provider to use: groq (default), openrouter, gemini or ollama
# PATCHPILOT_PROVIDER=groq

# The key for your provider. Ollama needs none.
# Groq:       https://console.groq.com/keys
# OpenRouter: https://openrouter.ai/keys
# Gemini:     https://aistudio.google.com/apikey
GROQ_API_KEY=your-groq-api-key
# OPENROUTER_API_KEY=your-openrouter-api-key
# GEMINI_API_KEY=your-gemini-api-key
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional overrides (defaults shown). The model defaults to the provider's default.
# PATCHPILOT_MODEL=openai/gpt-oss-120b
# PATCHPILOT_MAX_ATTEMPTS=3
# PATCHPILOT_MAX_STEPS=10
# PATCHPILOT_RUN_TIMEOUT=10
# PATCHPILOT_COMMAND_TIMEOUT=300
# PATCHPILOT_LOG_LEVEL=WARNING
